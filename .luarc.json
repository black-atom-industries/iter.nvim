{
    "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
    "diagnostics.globals": [
        "vim",
        "MiniTest"
    ],
    "diagnostics.disable": [
        "need-check-nil"
    ],
    "runtime.version": "LuaJIT",
    "runtime.path": [
        "lua/?.lua",
        "lua/?/init.lua",
        "?.lua",
        "?/init.lua"
    ],
    "runtime.pathStrict": true,
    "workspace.checkThirdParty": false,
    "workspace.library": [
        "$VIMRUNTIME/lua"
    ],
    "workspace.ignoreDir": [
        ".vscode"
    ],
    "diagnostics.unusedLocalExclude": [
        "_*"
    ]
}
